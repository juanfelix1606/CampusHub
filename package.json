{
  "name": "campushub",
  "version": "0.1.0",
  "private": true,
  "description": "CampusHub - campus LMS and QR attendance portfolio project",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @campushub/api",
    "dev:web": "npm run dev --workspace @campushub/web",
    "build": "npm run build --workspace @campushub/api && npm run build --workspace @campushub/web",
    "lint": "eslint apps/api/src apps/api/scripts apps/web/src playwright.config.ts eslint.config.mjs e2e",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"e2e/**/*.ts\" \"*.{json,js,mjs,ts}\" \".github/workflows/*.yml\"",
    "test:e2e": "playwright test",
    "test": "npm run test --workspace @campushub/api",
    "test:unit": "npm run test:unit --workspace @campushub/api",
    "test:integration": "npm run test:integration --workspace @campushub/api",
    "db:generate": "npm run db:generate --workspace @campushub/api",
    "db:migrate": "npm run db:migrate --workspace @campushub/api",
    "db:deploy": "npm run db:deploy --workspace @campushub/api",
    "db:seed": "npm run db:seed --workspace @campushub/api",
    "storage:smoke": "npm run storage:smoke --workspace @campushub/api",
    "demo:seed": "npm run demo:seed --workspace @campushub/api",
    "demo:reset": "npm run demo:reset --workspace @campushub/api"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
