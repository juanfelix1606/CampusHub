# Local PostgreSQL connection. Update these values if you change the Compose defaults.
DATABASE_URL="postgresql://campushub:campushub_local@localhost:5432/campushub?schema=public"
TEST_DATABASE_URL="postgresql://campushub:campushub_local@localhost:5433/campushub_test?schema=public"

# Required by the development seed only. Use a throwaway password (12+ characters).
DEMO_PASSWORD="change-this-local-demo-password"

API_PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Required by the API; generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Generate independently from JWT_ACCESS_SECRET; minimum 32 characters and 12 distinct characters.
ATTENDANCE_QR_SECRET=
# Lecturer dashboard risk flags (attendance percentage / overdue assignments).
DASHBOARD_RISK_ATTENDANCE_PERCENT=75
DASHBOARD_RISK_MISSED_ASSIGNMENTS=2

# Docker Compose PostgreSQL defaults for local development only.
POSTGRES_DB=campushub
POSTGRES_USER=campushub
POSTGRES_PASSWORD=campushub_local

# Local upload storage. Keep this directory outside source control.
MATERIAL_STORAGE_DIR="./uploads/materials"
